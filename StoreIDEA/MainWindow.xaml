<Window x:Class="StoreIDEA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoreIDEA"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Логин" Height="25" Width="250" Padding="10" Margin="0, 0, 0, 40" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="14" Foreground="Black"/>
        <TextBlock Text="Пароль" Height="30" Width="250" Padding="10" Margin="0,145,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="14" Grid.RowSpan="2"/>

        <TextBox Grid.Row="0" Height="25" Width="250" Padding="10" Margin="10" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="14"/>
        <TextBox Grid.Row="1" Height="25" Width="250" Padding="10" Margin="0,36,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="14"/>
        <Button Grid.Row="1" Content="Войти" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20" Height="50" Width="100" Click="EnterButton_Click"/>
    </Grid>
</Window>
