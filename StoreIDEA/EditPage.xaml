<Page x:Class="StoreIDEA.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StoreIDEA"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="EditPage">

    <Grid>
        <Button Name="CancelBtn" Content="Назад" VerticalAlignment="Top" HorizontalAlignment="Left" Click="CancelBtn_Click"/>
        <StackPanel HorizontalAlignment="Center" Width="200">
            <Label Content="Артикул" FontSize="14" HorizontalAlignment="Center"/>
            <TextBox Name="ArticulTb" Width="200"/>
            <Label Content="Название продукта" FontSize="14" HorizontalAlignment="Center"/>
            <TextBox Name="ProductNameTb" Width="200"/>
            <ComboBox Name="UnitOfMeasurementCb" DisplayMemberPath="UnitOfMeasurementName" SelectedValuePath="UnitOfMeasurementID" Margin="10" SelectionChanged="UnitOfMeasurementCb_SelectionChanged"/>
            <Label Content="Цена" HorizontalAlignment="Center" FontSize="14"/>
            <TextBox Name="PriceTb" Width="120"/>
            <ComboBox Name="SupplierCb" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierID" Margin="10"/>
            <ComboBox Name="ManufacturerCb" DisplayMemberPath="ManufacturerName" SelectedValuePath="ManufacturerID" Margin="10"/>
            <ComboBox Name="CategoryCb" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" Margin="10"/>
            <Label Content="Скидка" HorizontalAlignment="Center" FontSize="14"/>
            <TextBox Name="DiscountTb" Width="120"/>
            <Label Content="Количество на складе" HorizontalAlignment="Center" FontSize="14"/>
            <TextBox Name="QuantityInStockTb" Width="120"/>
            <Label Content="Описание" HorizontalAlignment="Center" FontSize="14"/>
            <TextBox Name="DescriptionTb" Width="170" Height="67"/>
            <Button Name="EditBtn" Content="Редактировать" Click="EditBtn_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>
