<Page x:Class="StoreIDEA.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StoreIDEA"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Source="/Images/idea_logo.png" HorizontalAlignment="Left" Width="50" Height="50"/>
        <TextBlock FontFamily="Comic Sans MS" Grid.Row="0" Text="Сувениры" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="22" Foreground="Black" Margin="10"/>
        <StackPanel Orientation="Horizontal">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <ComboBox Name="CategoryCb" DisplayMemberPath="CategoryName" Visibility="Hidden" SelectionChanged="CategoryCb_SelectionChanged"/>
            <ComboBox Name="SupplierCb" DisplayMemberPath="SupplierName" Visibility="Hidden" SelectionChanged="SupplierCb_SelectionChanged"/>
            <Button Name="AddBtn" Grid.Row="1" Grid.Column="2" Content="Добавить" Visibility="Hidden" HorizontalAlignment="Right" Margin="5" Click="AddBtn_Click"/>
            <Button Name="EditBtn" Grid.Row="1" Grid.Column="2" Content="Редактировать" Visibility="Hidden" HorizontalAlignment="Right" Margin="5" Click="EditBtn_Click"/>
            <Button Name="RemoveBtn" Grid.Row="1" Grid.Column="2" Content="Удалить" Visibility="Hidden" HorizontalAlignment="Right" Margin="5" Click="RemoveBtn_Click"/>
        </StackPanel>
        <ListView FontFamily="Comic Sans MS" Grid.Row="1" x:Name="productListView" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Left"></StackPanel>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" CornerRadius="5" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" MouseDoubleClick="Name2Click">
                                <StackPanel Width="400" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Categories.CategoryName}"/>
                                        <TextBlock Text="   |   "/>
                                        <TextBlock Text="{Binding ProductName}"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Price,StringFormat={}Цена: {0}}"/>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding Description,StringFormat={}Описание: {0}}"/>
                                </StackPanel>
                            </Label>
                            <StackPanel Grid.Column="2" Width="200" HorizontalAlignment="Center">
                                <TextBlock TextAlignment="Center" Text="{Binding Discount, ValidatesOnExceptions=True, StringFormat={}{0} %}"/>
                                <Button Name="History" Click="HistoryClick">История взаимодействия</Button>
                            </StackPanel>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding ImagePath}" Width="100" Height="100"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
